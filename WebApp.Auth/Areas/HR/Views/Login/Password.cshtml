@model UserLoginVM
@{
    ViewData["Title"] = Localizer["Login Password"];
}

<!-- Login -->
<div class="d-flex col-12 col-lg-4 align-items-center authentication-bg p-sm-12 p-6">
    <div class="w-px-400 mx-auto mt-12 pt-5">
        <h4 class="mb-1">@Localizer["Welcome to HR System"]</h4>
        <p class="mb-6">@Localizer["Please sign-in to your account and start the adventure"],</p>

        <form asp-action="Password" class="mb-6">
            <input type="hidden" asp-for="UserName" />

            <div class="mb-6 position-relative">
                <input class="form-control ps-7"
                       asp-for="UserName"
                       autofocus
                       placeholder="@Localizer["Enter your email"]"
                       required
                       disabled />
                <div class="icon-position">
                    <i class="fa-solid fa-user"></i>
                </div>
            </div>
            <div class="mb-6 position-relative form-password-toggle">
                <div class="input-group input-group-merge ">
                    <input asp-for="Password" 
                           class="form-control ps-7 "
                           autofocus
                           placeholder="@Localizer["Password"]"
                           required />                
                    <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
                    <div class="icon-position">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                   
                </div>
                <span asp-validation-for="Password" class="text-danger error-message">@ViewBag.Error</span>
                @if (ViewBag.NotVerified == true)
                {
                    <div class="mt-2 text-start">
                        <a href="/HR/Register/Verify?email=@Model.UserName" class="btn btn-warning btn-sm w-100 mt-2 text-white">
                            <i class="fa-solid fa-envelope-circle-check me-2"></i> @Localizer["Click Here to Verify Your Email"]
                        </a>
                    </div>
                }
               
            </div>
            <button type="submit" class="btn btnn-primary d-grid w-100">@Localizer["Login"]</button>
            <div class="my-6">
                <div class="d-flex justify-content-between ">
                    <a asp-action="Index" asp-controller="ForgetPassword" asp-area="HR">
                        <p class="mb-0 teext-primary">@Localizer["Forgot Password"]?</p>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- /Login -->
