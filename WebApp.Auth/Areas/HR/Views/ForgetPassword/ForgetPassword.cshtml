@model ResetPasswordDto
@{
    ViewData["Title"] = Localizer["Reset Password"];
}

<div class="d-flex col-12 col-lg-4 align-items-center authentication-bg p-sm-12 p-6">
    <div class="w-px-400 mx-auto mt-12 pt-5">
        <h4 class="mb-1">@Localizer["Welcome to HR System"]!</h4>
        <p class="mb-6">@Localizer["Enter and confirm your new password to reset it."],</p>

        <form asp-action="ForgetPassword" class="mb-6">
                <input type="hidden" asp-for="Email" />
            <div class="mb-6 position-relative form-password-toggle">
                <div class="input-group input-group-merge">
                    <input asp-for="Password"
                           type="password" id="Password"
                           class="form-control ps-7"
                           autofocus
                           placeholder="@Localizer["Password"]"
                           required />
                    <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
                    <div class="icon-position">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-6 position-relative form-password-toggle">
                <div class="input-group input-group-merge">
                    <input asp-for="ConfirmPassword"
                           type="password" id="ConfirmPassword"
                           class="form-control ps-7"
                           placeholder="@Localizer["Confirm Password"]"
                           required />
                    <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
                    <div class="icon-position">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btnn-primary d-grid w-100">@Localizer["Reset Password"]</button>
        </form>
        
    </div>
</div>

@section Scripts{
    <script>
            $(document).ready(function () {
            $("form").on("submit", function (e) {
                let isValid = true;
                const password = $("#Password").val();
                const confirmPassword = $("#ConfirmPassword").val();

                // Clear old errors
                $("span[data-valmsg-for='Password']").text('');
                $("span[data-valmsg-for='ConfirmPassword']").text('');



                // Confirm password match
                if (password !== confirmPassword) {
                    $("span[data-valmsg-for='ConfirmPassword']").text('The password and confirm password does not match.');
                    isValid = false;
                }

                if (!isValid) {
                    e.preventDefault(); // Stop form submission
                }
            });
        });

    </script>
}
