@inject IStringLocalizer Localizer
@inject IConfiguration Configuration
@{
    string assetsCDN = Configuration["CDN:HR"];
}

<!DOCTYPE html>
<html lang="en"
      class="light-style layout-wide customizer-hide"
      dir="ltr"
      data-theme="theme-default"
      data-assets-path="@assetsCDN/"
      data-template="vertical-menu-template"
      data-style="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>@ViewData["Title"] - @Localizer["HR"]</title>

    <script type="importmap"></script>

    <meta name="description" content="" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/assets/img/hr-img/hr-icon.ico">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&ampdisplay=swap"
          rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet" href="@assetsCDN/vendor/fonts/fontawesome.css" />
    <link rel="stylesheet" href="@assetsCDN/vendor/fonts/tabler-icons.css" />
    <link rel="stylesheet" href="@assetsCDN/vendor/fonts/flag-icons.css" />

    <!-- Core CSS -->

    <link rel="stylesheet" href="@assetsCDN/vendor/css/rtl/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="@assetsCDN/vendor/css/rtl/theme-default.css" class="template-customizer-theme-css" />

    <link rel="stylesheet" href="~/assets/css/colors-HR.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/HR.css" asp-append-version="true" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="@assetsCDN/vendor/libs/node-waves/node-waves.css" />

    <link rel="stylesheet" href="@assetsCDN/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="@assetsCDN/vendor/libs/typeahead-js/typeahead.css" />
    <!-- Vendor -->
    <link rel="stylesheet" href="@assetsCDN/vendor/libs/@@form-validation/form-validation.css" />
    <link rel="stylesheet" href="@assetsCDN/vendor/libs/animate-css/animate.css">
    <link rel="stylesheet" href="@assetsCDN/vendor/libs/sweetalert2/sweetalert2.css">

    <!-- Page CSS -->
    <!-- Page -->
    <link rel="stylesheet" href="@assetsCDN/vendor/css/pages/page-auth.css" />

    <!-- Helpers -->
    <script src="@assetsCDN/vendor/js/helpers.js"></script>
    <!--! Template customizer & Theme config files MUST be included after core stylesheets and helpers.js in the <head> section -->
    <!--? Template customizer: To hide customizer set displayCustomizer value false in config.js.  -->
    <script src="@assetsCDN/vendor/js/template-customizer.js"></script>

    <!--? Config:  Mandatory theme config file contain global vars & default theme options, Set your preferred theme option in this file.  -->
    <script src="@assetsCDN/js/config.js"></script>
</head>
<body>
    <div class="loading-page d-none">
        <div>
            <div class="demo-inline-spacing">
                <div class="spinner-border spinner-border-lg teext-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
    <!-- Content -->
    <div class="authentication-wrapper authentication-cover">
        <!-- Logo -->
        <!-- /Logo -->
        <div class="authentication-inner row m-0">
            <!-- /Left Text -->
            <div class="d-none d-lg-flex col-lg-8 p-0">
                <div class="bg-white card auth-cover-bg auth-cover-bg-color d-flex justify-content-center align-items-center">
                    <img src="~/assets/img/HR-img/Logo.png"
                         alt=""
                         class="my-5 auth-illustration" />
                </div>
            </div>
            <!-- /Left Text -->
            @RenderBody()
        </div>
    </div>

    <!-- / Content -->
    <!-- Core JS -->
    <!-- build:js assets/vendor/js/core.js -->

    <script src="@assetsCDN/vendor/libs/jquery/jquery.js"></script>
    <script src="@assetsCDN/vendor/libs/popper/popper.js"></script>
    <script src="@assetsCDN/vendor/js/bootstrap.js"></script>
    <script src="@assetsCDN/vendor/libs/node-waves/node-waves.js"></script>
    <script src="@assetsCDN/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="@assetsCDN/vendor/libs/hammer/hammer.js"></script>
    <script src="@assetsCDN/vendor/libs/i18n/i18n.js"></script>
    <script src="@assetsCDN/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="@assetsCDN/vendor/js/menu.js"></script>

    <!-- endbuild -->
    <!-- Vendors JS -->
    <script src="@assetsCDN/vendor/libs/@@form-validation/popular.js"></script>
    <script src="@assetsCDN/vendor/libs/@@form-validation/bootstrap5.js"></script>
    <script src="@assetsCDN/vendor/libs/@@form-validation/auto-focus.js"></script>
    <script src="@assetsCDN/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <!-- Main JS -->
    <script src="@assetsCDN/js/main.js"></script>

    <!-- Page JS -->
    <script src="@assetsCDN/js/pages-auth.js"></script>
    <script src="/assets/js/custom.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
