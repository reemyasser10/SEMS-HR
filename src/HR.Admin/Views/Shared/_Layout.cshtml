<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SEMS HR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    
    <header class="sems-header">
        <div class="sems-logo">
            SEMS <span>School Enterprise Management System</span>
        </div>
        <nav class="sems-nav">
            <a href="#">Setup</a>
            <a href="#">Students</a>
            <a href="#" class="active">Staff</a>
            <a href="#">Services</a>
            <a href="#">Themes</a>
        </nav>
        <div class="sems-header-right">
            <span>Sunday, 13 September 2026 18:31:58</span>
            <a href="#">EduHub</a>
            <a href="#">Change Password</a>
            <a asp-controller="Auth" asp-action="Logout">Logout</a>
        </div>
    </header>
    
    <div class="sems-banner">
        كل عام وانتم بخير بمناسبه قرب انتهاء الشهر الكريم وكل عام وانتم بخير بمناسبه عيد الفطر المبارك والمزيد أضغط هنا
    </div>

    <div class="sems-container">
        <aside class="sems-sidebar">
            <div class="sems-sidebar-card">
                <div class="sems-sidebar-title">MENU</div>
                <button class="btn btn-outline-secondary w-100">Top Management Reports</button>
            </div>
            
            <div class="sems-sidebar-card">
                <div class="sems-sidebar-title">WORK PLACE</div>
                <select class="form-select">
                    <option>Main Campus</option>
                </select>
                <div class="mt-2 text-primary" style="font-size:12px;cursor:pointer;">
                    Search &nbsp; Help
                </div>
            </div>

            <div class="sems-sidebar-card">
                <div class="sems-sidebar-title">MAIN MODULE</div>
                <div class="text-muted mb-2" style="font-size:12px;">Staff -> Profile</div>
                <div class="sems-sidebar-menu">
                    <ul>
                        <li><a href="#" class="active">Employee Personal Details NEW</a></li>
                        <li><a href="#">Employee Documents</a></li>
                        <li><a href="#">Approve Employee Status</a></li>
                        <li><a href="#">Reports</a></li>
                    </ul>
                </div>
            </div>

            <div class="sems-sidebar-card">
                <div class="sems-sidebar-title">AREAS</div>
                <div class="sems-sidebar-menu">
                    <ul>
                        <li><a href="#" class="active">Staff -> Profile</a></li>
                        <li><a href="#">Employee Vacation</a></li>
                        <li><a href="#">Staff -> Payroll</a></li>
                    </ul>
                </div>
            </div>
        </aside>

        <main class="sems-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
